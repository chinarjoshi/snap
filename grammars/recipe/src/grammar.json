{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "recipe",
  "rules": {
    "recipe": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_line_content"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "\n"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_line_content"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "_line_content": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "header_line"
        },
        {
          "type": "SYMBOL",
          "name": "ingredient_line"
        },
        {
          "type": "SYMBOL",
          "name": "text_line"
        }
      ]
    },
    "header_line": {
      "type": "PREC_DYNAMIC",
      "value": 10,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "REPEAT1",
            "content": {
              "type": "SYMBOL",
              "name": "word"
            }
          },
          {
            "type": "STRING",
            "value": ":"
          }
        ]
      }
    },
    "ingredient_line": {
      "type": "PREC_DYNAMIC",
      "value": 5,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "quantity"
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "word"
                },
                {
                  "type": "SYMBOL",
                  "name": "number"
                }
              ]
            }
          }
        ]
      }
    },
    "text_line": {
      "type": "PREC_DYNAMIC",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "word"
            },
            {
              "type": "SYMBOL",
              "name": "number"
            },
            {
              "type": "SYMBOL",
              "name": "punctuation"
            }
          ]
        }
      }
    },
    "quantity": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "min",
              "content": {
                "type": "SYMBOL",
                "name": "number"
              }
            },
            {
              "type": "STRING",
              "value": "-"
            },
            {
              "type": "FIELD",
              "name": "max",
              "content": {
                "type": "SYMBOL",
                "name": "number"
              }
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "number"
          }
        }
      ]
    },
    "word": {
      "type": "PATTERN",
      "value": "[a-zA-Z]+"
    },
    "number": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "punctuation": {
      "type": "PATTERN",
      "value": "[^\\s\\na-zA-Z0-9:]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [
    [
      "ingredient_line",
      "text_line"
    ],
    [
      "header_line",
      "text_line"
    ],
    [
      "quantity",
      "text_line"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}